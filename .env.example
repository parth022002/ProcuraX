# Copy to .env. Placeholder values only — never place live secrets here.
APP_ENV=development
APP_NAME=ProcuraX API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Local Docker Compose PostgreSQL (optional)
POSTGRES_DB=procurax
POSTGRES_USER=procurax
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://procurax:change_me_locally@localhost:5433/procurax

# Optional local cache
REDIS_URL=redis://localhost:6379/0

# LLM provider defaults to no-cost deterministic fallback until configured
LLM_PROVIDER=rule_based
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Reproducibility / demo settings
DATA_SEED=42
DATA_AS_OF=2026-09-30
DEMO_MODE=true
APPROVAL_THRESHOLD_INR=10000000


# External public-data providers (optional; leave blank unless you have a key)
MARKETAUX_API_TOKEN=
ALPHA_VANTAGE_API_KEY=
NEWSDATA_API_KEY=
SEC_USER_AGENT=ProcuraXResearch contact@example.com

# Signal collection controls (conservative PoC defaults; respect provider plans)
SIGNAL_PROVIDERS_ENABLED=gdelt,sec
SIGNAL_FETCH_MAX_ARTICLES=100
SIGNAL_FETCH_TIMEOUT_SECONDS=20
SIGNAL_FETCH_MAX_RETRIES=2
SIGNAL_CACHE_TTL_SECONDS=900
SIGNAL_DEFAULT_LOOKBACK_DAYS=7
SIGNAL_LIVE_FETCH_ENABLED=false
