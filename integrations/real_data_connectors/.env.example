# Copy this file to .env and insert keys from the providers' official sites.
# Do not commit .env to Git.
MARKETAUX_API_TOKEN=
ALPHA_VANTAGE_API_KEY=
NEWSDATA_API_KEY=

# SEC doesn't issue an API key for its public submissions/companyfacts APIs.
# Use a descriptive app name plus contact email; for example:
SEC_USER_AGENT=ProcuraXResearch contact@example.com

# Query tuning
GDELT_TIMESPAN=7d
GDELT_MAX_RECORDS=100
MARKETAUX_SEARCH="supplier | \"supply chain\" | semiconductor | logistics | \"factory shutdown\" | port disruption"
MARKETAUX_LIMIT=3
ALPHA_VANTAGE_TOPICS=manufacturing
ALPHA_VANTAGE_LIMIT=100
NEWSDATA_QUERY=supply chain OR supplier OR logistics OR port disruption OR semiconductor shortage
NEWSDATA_SIZE=10
SEC_TICKERS=AAPL,TSLA,TM
